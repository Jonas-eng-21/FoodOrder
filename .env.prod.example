# FoodOrder — production stack template (copy to .env.prod; never commit the real file).
#   cp .env.prod.example .env.prod
#   scripts/prod/dcp.sh build && scripts/prod/dcp.sh init-key
APP_NAME=FoodOrder
APP_ENV=production
# Filled by `scripts/prod/dcp.sh init-key` (a key different from the development one). Never commit it.
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Required marker of the production stack (must be exactly 1).
FOODORDER_ENV_PROD=1

# Published only on 127.0.0.1 (private demo). Change the port here if 8081 is taken.
PROD_PORT=8081

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
