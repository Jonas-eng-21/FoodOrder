APP_NAME=FoodOrder
APP_ENV=local
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Development stack only. Must stay empty here (production uses its own env file).
FOODORDER_ENV_PROD=

# Docker development stack
DEV_BIND_ADDRESS=127.0.0.1
DEV_PORT=8080
APP_UID=1000
APP_GID=1000

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
