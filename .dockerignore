# Local development context and history (never part of an image)
context/

# Version control and local agent tooling
.git/
.agents/
.claude/
skills-lock.json

# Secrets and environment files (keep the templates)
.env
.env.*
!.env.example
!.env.prod.example

# Local databases and SQLite auxiliary files
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# Tests and operational scripts are not part of any image
tests/
scripts/

# Dependencies, caches, logs, backups and certificates
vendor/
node_modules/
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
.phpunit.cache/
*.log
*.bak
*.backup
*.pem
*.key
*.crt
